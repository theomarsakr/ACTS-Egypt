# Copy to .env.local and fill in. The site runs without any of these; only the
# RFQ form at /quote needs them.

# Supabase → Project Settings → API.
# Deliberately NOT prefixed NEXT_PUBLIC_: both are read server-side only, and
# a NEXT_PUBLIC_ value is inlined into the client bundle wherever it is used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Search Console → Settings → Ownership verification → HTML tag.
# Paste just the content="..." value, not the whole meta tag.
GOOGLE_SITE_VERIFICATION=

# resend.com → API Keys. Sends the RFQ form's confirmation + notification
# emails (app/api/inquiries/route.ts). The route degrades gracefully without
# it — the inquiry still saves to Supabase, it just won't email anyone.
RESEND_API_KEY=

# Sender for both RFQ emails. Must be an address on a domain verified in
# Resend. Without this the route falls back to Resend's shared
# onboarding@resend.dev, which only delivers to the Resend account owner —
# meaning customer confirmation emails silently never arrive.
RESEND_FROM="ACTS Website <noreply@actsegypt.com>"

# Where new RFQ notifications are sent. Defaults to the sales address in
# lib/data.ts when unset.
INQUIRY_NOTIFICATION_EMAIL=
